# ===== KeyLens environment =====
# Copy to .env (root) and tweak. The default below runs the whole product
# in mock mode with zero external credentials.

# Mock mode: all connectors/usage/rotation/alerts run on synthetic data.
MOCK_MODE=true

# SQLite database file (relative to packages/db). Swap to a Postgres
# connection string when you move to production (see README).
DATABASE_URL=file:./data/keylens.db

# Simple single-user portal gate for the scaffold. The dashboard sends this
# as `x-portal-token`. Leave empty to disable the gate locally.
PORTAL_TOKEN=dev-token-change-me

# --- Real connectors (only used when MOCK_MODE=false) ---
# GitHub: secret scanning connector (fine-grained PAT with repo/metadata read)
GITHUB_TOKEN=
# Vercel: org env-vars connector (token + team id)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# OpenAI admin: usage pull + service-account rotation (admin key + project)
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=
# Slack: alert delivery
SLACK_WEBHOOK_URL=
# Email: digest delivery (SMTP)
SMTP_URL=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
